{
  "name": "Meu Ambiente Postgres",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "meu-banco",
  "shutdownAction": "stopCompose",
  "portsAttributes": {
    "5432": {
      "label": "Banco de Dados Postgres",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  // Copia o arquivo de exemplo para o .env real se ele não existir
  "updateContentCommand": "if [ ! -f ../.env ]; then cp ../.env.example ../.env; fi"
}
